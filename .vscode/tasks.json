{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rodar no celular",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ${workspaceFolder}\\rodar.ps1",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Espelhar tela (scrcpy)",
      "type": "shell",
      "command": "scrcpy --stay-awake",
      "options": {
        "env": { "ADB": "${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools\\adb.exe" }
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Ver erros do app (logcat)",
      "type": "shell",
      "command": "& \"$env:LOCALAPPDATA\\Android\\Sdk\\platform-tools\\adb.exe\" logcat -v brief AndroidRuntime:E *:S",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
